# État de workflow local
# Les sessions sont un état d'exécution propre à une machine,
# pas du contenu de projet partagé.
sessions/
.agentic/
*.session.json

# Secrets et configuration locale
.env
.env.*
!.env.example
config/local.*
.claude/settings.local.json

# Logs et brouillons
*.log
logs/
tmp/
scratch/

# Système
.DS_Store
Thumbs.db

# Éditeurs
.vscode/
.idea/
*.swp
*.swo

# Artefacts d'exécution (langage non encore décidé, volontairement générique)
node_modules/
dist/
build/
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
